<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.blog</groupId>
    <artifactId>blog-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>blog-api</name>
    <description>Monolito de blog em Spring Boot - integrado ao microsservico de engajamento por http e por eventos</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- o boot 3.3 gerencia uma versao do testcontainers anterior ao docker 29, que
             recusa a versao de api que ela negocia. a 1.21.4 e a primeira da linha 1.x que
             conversa com o docker atual. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- web: controllers REST e servidor embarcado -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- persistencia via jpa/hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- historico de dados: hibernate envers exposto por repositorios spring data
             (RevisionRepository). traz o hibernate-envers transitivamente. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-envers</artifactId>
        </dependency>

        <!-- health checks: as sondas de liveness e readiness do kubernetes e o
             healthcheck do docker compose perguntam aqui se o processo esta vivo e pronto
             para receber trafego -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- validacao de dto com bean validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- spring cloud, terceira entrega -->

        <!-- cliente do config server: busca as propriedades de ambiente deste
             servico no servidor central antes de terminar de inicializar -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- spring-retry (e o aop que ele usa) fazem o cliente de configuracao
             retentar quando o config server ainda nao esta no ar, em vez de o servico
             morrer no startup por causa da ordem em que os processos subiram -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- cliente de descoberta: o monolito se registra no eureka e, mais
             importante, consulta o registro para achar o engagement-service pelo
             nome, sem host nem porta escritos no codigo -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!-- cliente http declarativo: a chamada ao microsservico e escrita como
             uma interface java, e o balanceamento entre instancias vem do spring
             cloud loadbalancer que o starter do eureka traz -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- circuit breaker: quando o engajamento cai, as chamadas falham rapido
             pelo fallback em vez de segurar threads esperando timeout -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- mensageria, quarta entrega -->

        <!-- rabbitmq pelo spring amqp: RabbitTemplate para publicar, @RabbitListener para
             consumir, e a declaracao de exchanges, filas e bindings como beans que o
             RabbitAdmin cria no broker ao conectar. o starter tambem traz a
             auto-configuracao da retentativa dos consumidores por propriedades. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- a api do opentelemetry, so a api (sem sdk): o outbox guarda o contexto do trace
             de quem gravou a mensagem e o restaura na hora de publicar. sem o agente, ela e
             um no-op; com o agente das imagens, o trace atravessa o outbox. a versao vem
             do bom do spring boot. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!-- banco em memoria: posts e autores continuam neste servico -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- implantacao, quinta entrega -->

        <!-- postgresql: o banco do ambiente de conteiner. o h2 em memoria continua sendo
             o do desenvolvimento e dos testes, mas nao serve para producao: zera a cada
             restart e, com duas replicas, cada uma teria o seu banco. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- migracoes versionadas do schema. em producao o schema nao e gerado pelo
             hibernate: e criado por scripts revisaveis, e o hibernate so confere se o
             mapeamento bate (ddl-auto: validate). ligado apenas no perfil container. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- reduz boilerplate de getters/construtores nas entidades -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- teste de integracao com um rabbitmq de verdade, em container. roda so quando
             ha docker na maquina: sem ele, a classe e pulada em vez de falhar, e o resto
             da suite continua sem depender de infraestrutura nenhuma. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- trem 2023.0.x (Leyton), a linha do spring cloud compativel com o
                 spring boot 3.3.x. o mesmo BOM e importado em todos os servicos. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- cobertura de testes: o relatorio sai em target/site/jacoco a cada
                 ./mvnw verify, e o pipeline o publica como artefato -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
