# o front no conteiner: o nginx serve os arquivos estaticos do build do vite e repassa
# /api ao monolito. o navegador fala com uma origem so -- a mesma decisao da terceira
# entrega, agora sem precisar de cors: front e api estao no mesmo endereco.
#
# ${BLOG_API_URL} e substituido na subida do conteiner (a imagem oficial do nginx passa
# os arquivos de /etc/nginx/templates pelo envsubst). no compose e no kubernetes ele
# aponta para o nome do servico do monolito na rede interna.

server {
    # ipv4 e ipv6: dentro do conteiner alpine, "localhost" resolve primeiro para ::1, e
    # um nginx so em ipv4 recusava a propria sonda de saude (achado subindo o compose)
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # o id da requisicao vai para o monolito e volta na resposta: e a ponte entre o log
    # de acesso do nginx e o que aconteceu la dentro
    location /api/ {
        proxy_pass ${BLOG_API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        add_header X-Request-Id $request_id always;
        proxy_read_timeout 15s;
    }

    # os assets do vite tem hash no nome: podem ficar em cache para sempre
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # spa: toda rota que nao e arquivo cai no index.html, e o react-router resolve
    # (sem isto, recarregar /posts/1 daria 404 do nginx)
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }

    # sonda simples para o kubernetes e o compose: o nginx esta de pe
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
